2026-03-18 14:53:10,353 [DEBUG] aiosqlite:104 - executing functools.partial(<built-in method execute of sqlite3.Cursor object at 0x000002138B9D8EC0>, 'INSERT INTO chapter_versions (chapter_id, version_label, provider, content, metadata) VALUES (?, ?, ?, ?, ?) RETURNING id, created_at', (4, 'v2', None, '第4章 - 药奴青衣\n\n"有意思。"\n\n老头重复了一遍这三个字，那双浑浊的老眼在韩墨身上来回刮了几遍，像是在估量一件货物的成色。\n\n"既不是药王谷的，也不是哪门哪派的，却能一眼瞧出乌头配半夏的忌讳。"老头慢吞吞地收回身子，重新拿起那杆银秤，"这年头，认字的穷酸读书人不少，认得药的可不多。"\n\n韩墨垂着眼，没敢接话。\n\n在这种人精面前，多说是错，少说也是错，唯有装傻充愣，才能活得久些。\n\n"罢了。"\n\n老头摆了摆手，像是在赶一只苍蝇，"既然死不了，就别在这儿碍眼。后院有个柴房，自己过去歇着。明日卯时，过来帮我晒药。"\n\n韩墨如蒙大赦。\n\n他撑着地面，艰难地爬起来。浑身骨头都在抗议，每动一下都像是有无数根钢针在扎。但他咬着牙，硬是一声没吭，拖着两条灌铅似的腿，朝着那扇通往后院的半掩木门走去。\n\n身后传来银秤碰击桌案的轻响，和老头若有若无的嘀咕：\n\n"读书人......哼，读书人死得最快。"\n\n......\n\n跨过门槛的瞬间，光线骤然暗了下来。\n\n后院比韩墨想象的要大得多。四周围着高高的土墙，墙头上插满了碎玻璃和尖竹刺，防贼，也防人逃出去。院子一角堆着小山似的煤块，另一角是用茅草搭的棚子，底下架着一口巨大的铁锅，锅里熬着什么黑乎乎的东西，咕嘟咕嘟冒着泡，散发出一股令人作呕的腥甜味。\n\n柴房在最里面，紧挨着院墙。\n\n韩墨深一脚浅一脚地走过去，脚下的泥土湿软黏腻，像是踩在腐烂的肉上。空气中混杂着药香、煤灰味，还有一股若有若无的......臭味。\n\n不是那种陈年积垢的馊味，也不是死老鼠烂在墙角的腐味。\n\n而是一种带着甜腻的、生猛的、像伤口化脓被烈日暴晒后的恶臭。\n\n他皱了皱眉。\n\n这味道是从柴房旁边的一个低矮棚屋里飘出来的。那棚屋用烂木板胡乱钉成，缝隙大得能塞进拳头，门口挂着一块脏兮兮的黑布，挡住了里头的情形。\n\n铁链拖地的声音，就是从那里面传出来的。\n\n"哗啦——"\n\n轻微，断续，像是有什么东西在里面挪动。\n\n韩墨停在原地，屏住呼吸。\n\n理智告诉他，别多管闲事。这鬼地方，知道得越多，死得越快。老头既然把他扔在这儿晒药，说明暂时还需要他这条命来当试药的小白鼠。只要老老实实干活，熬过这一阵，总能找到逃跑的机会。\n\n可是......\n\n那股臭味太浓了。\n\n浓得让他想起"等死坑"里那些爬满蛆虫的尸体，想起刀疤刘把奄奄一息的矿工像扔垃圾一样丢进坑里的画面。\n\n韩墨攥紧了拳头。\n\n他不是什么善男信女。前世在职场摸爬滚打，什么阴私手段没见过？为了一个项目，同事之间能捅刀子；为了升职，能踩着别人的脑袋上位。穿越到这该死的世道，他比谁都清楚，心软的人活不长。\n\n但好奇心，是人的本能。\n\n尤其是像他这种，在绝境中刚抓到一根救命稻草的人。任何一点额外的信息，都可能成为日后保命的本钱。\n\n他左右看了看，确定老头没有跟出来，便蹑手蹑脚地朝那棚屋走去。\n\n......\n\n"哗啦——"\n\n铁链声更清晰了。\n\n韩墨站在棚屋门口，伸出手，轻轻掀开那块黑布的一角。\n\n一股浓烈的腐臭扑面而来，呛得他差点干呕出来。\n\n昏暗中，他看见了一双脚。\n\n一双瘦得皮包骨头、脚踝上勒着生锈铁镣的脚。脚背上的皮肤溃烂流脓，蛆虫在腐肉间蠕动，白花花的一片。\n\n韩墨的瞳孔猛地收缩。\n\n他强忍着恶心，把黑布掀得更高些。\n\n借着院子里透进来的微光，他终于看清了棚屋里的全貌——\n\n那是一个人。\n\n一个女人。\n\n她蜷缩在角落的稻草堆里，浑身穿着一件破烂不堪的青色布衣，那衣衫早已看不出原本的颜色，污血和脓液将布料黏在皮肉上。她浑身上下没一块好肉，溃烂的伤口遍布四肢和躯干，有的深可见骨，有的结着黑紫色的血痂。一头枯草般的长发遮住了大半张脸，只露出一双眼睛——\n\n那双眼睛正死死盯着韩墨。\n\n警惕，恐惧，仇恨，像被逼到绝境的困兽。\n\n"别......别过来......"\n\n她从喉咙里挤出沙哑的声音，像两片砂纸在摩擦。身体往后缩，铁链哗哗作响。\n\n韩墨愣住了。\n\n不是因为她的惨状——这种场面，他在"等死坑"里见得多了。\n\n而是因为......她的脸。\n\n尽管溃烂了大半，五官却依然能看出原本的精致。眉眼如画，鼻梁秀挺，下巴尖尖的......若是在太平盛世，这该是个被人捧在手心里的娇小姐。\n\n可现在，她却像条狗一样被锁在这个暗无天日的棚屋里，等死。\n\n"你是谁？"\n\n韩墨压低声音问。\n\n女人没有回答。她只是死死盯着他，身体绷得紧紧的，随时准备扑上来撕咬。\n\n"我不是坏人。"韩墨尽量让自己的声音听起来平和，"我也是被抓来的。"\n\n女人的眼神松动了一下。\n\n"叶孤舟......"她喃喃道，"是叶孤舟抓你来的？"\n\n叶孤舟？\n\n韩墨反应过来——这应该就是那个老头的名字。\n\n"算是吧。"他苦笑，"他救了我一命，让我给他当试药的药奴。"\n\n"药奴......"\n\n女人的声音里带着一丝自嘲，"那你......迟早也会变成我这样。"\n\n"你是什么样？"\n\n韩墨问出了口，随即就后悔了。\n\n这问题太蠢。\n\n女人抬起头，露出那张狰狞的脸。\n\n"我是他的......试验品。"\n\n她一字一顿地说，每一个字都像是从牙缝里挤出来的，"他给我下毒，再给我解毒，反反复复......看哪种药能把人毒死，哪种药能让人活下来......活下来，再接着试......"\n\n她的声音渐渐低了下去，变成了呢喃。\n\n"十年了......我都不记得......试了多少种......"\n\n韩墨的后背窜上一股凉气。\n\n十年？\n\n这个女人，被这老头当作试验品折磨了整整十年？\n\n他下意识地往后退了半步，脚后跟碰到了门框。\n\n"你......"\n\n他刚想说什么，却看见女人的目光突然变得锐利起来。\n\n"你走！"\n\n她厉声喝道，"别管我！他要是发现你......你也活不了！"\n\n韩墨愣了愣。\n\n这个已经被折磨得不成人形的女人，竟然......在担心他？\n\n一种奇怪的情绪涌上心头。\n\n不是同情——他韩墨还没有那么多泛滥的同情心。\n\n而是一种......算计。\n\n他盯着女人溃烂的伤口，脑子里飞快地转动。\n\n这女人被折磨了十年还没死，说明老头在她身上投入了大量的资源。以那老头的吝啬性子，绝不可能白白养一个废人。\n\n那这女人身上，一定有什么东西，值得老头花这么大的代价维持她的性命。\n\n是什么？\n\n韩墨的目光落在她的伤口上。\n\n溃烂，流脓，蛆虫......\n\n等等。\n\n他突然发现了什么。\n\n那些伤口......虽然看起来触目惊心，但溃烂的边缘......竟然长出了新肉。\n\n粉嫩的，鲜红的，正在缓慢愈合的新肉。\n\n韩墨蹲下身，凑近了一些。\n\n果然。\n\n这些伤口表面看起来吓人，实际上......都在往好的方向发展。那些脓水不是普通的脓水，而是带着药性的——老头在用一种极其霸道的方式，给她治疗。\n\n为什么要这样？\n\n既折磨她，又给她治伤？\n\n韩墨的脑子里灵光一闪。\n\n药。\n\n老头在试药。\n\n但这不是普通的试药——他在用这女人的身体，培养什么东西。\n\n韩墨的目光落在了女人眉心那道若隐若现的黑气上。\n\n那黑气......在蠕动。\n\n像是......活的。\n\n他倒吸一口凉气。\n\n蛊？\n\n传说中的苗疆蛊毒？\n\n不，不对。他一个现代穿越者，哪懂什么蛊不蛊的。但他的直觉告诉他，这女人身上，藏着天大的秘密。\n\n一个可能让他在这鬼地方活下来的秘密。\n\n"你叫什么名字？"\n\n他问。\n\n女人怔了怔，似乎没想到他会问这个。\n\n"......青衣。"\n\n"青衣。"\n\n韩墨点了点头，"我叫韩墨。"\n\n他深吸一口气，做出了一个决定。\n\n"你的伤口......需要清理。"\n\n青衣愣住了。\n\n"什么？"\n\n"你的伤口。"韩墨指了指她的腿，"那些脓水和蛆虫，如果不清理干净，新肉长不出来，你会一直疼下去。"\n\n"你......你懂医术？"\n\n青衣的声音里带着一丝不敢置信。\n\n"不懂。"\n\n韩墨回答得很干脆，"但在矿坑里待过的人，多少都懂得怎么处理伤口。不然，一个小小的划伤，就能要了你的命。"\n\n他顿了顿，又补充道：\n\n"我没有药，只能用清水帮你洗一洗。但总比什么都不做强。"\n\n青衣沉默了。\n\n她低着头，看着自己溃烂的双腿，良久，才轻轻点了点头。\n\n"......好。"\n\n......\n\n韩墨找来一只破陶碗，从院子角落的水缸里舀了些清水。\n\n他撕下自己衣摆的一块布，浸湿，然后蹲在青衣面前。\n\n"可能会有点疼。"\n\n他说。\n\n青衣咬紧牙关，没说话。\n\n韩墨开始擦拭她的伤口。\n\n腐肉，脓水，蛆虫......那些恶心的东西被他一点点擦去，露出下面鲜红的新肉。青衣的身体在剧烈颤抖，但她一声不吭，只是死死抓着身下的稻草，指节泛白。\n\n韩墨的动作很轻。\n\n轻得不像是一个从矿坑里爬出来的苦力。\n\n连他自己都觉得奇怪。\n\n明明只是想套话，想探听秘密，想利用这个女人......可当他的手触碰到那些伤口时，心里却涌上了一股莫名的情绪。\n\n那是一种......感同身受。\n\n他也是这样爬出"等死坑"的。\n\n他也是这样，在绝望中等待有人能拉他一把。\n\n可没有人。\n\n从来都没有人。\n\n"你......为什么要帮我？"\n\n青衣的声音打断了他的思绪。\n\n韩墨抬起头，对上她那双警惕又困惑的眼睛。\n\n"我说了，我只是——"\n\n"你不是。"\n\n青衣打断他，"你的眼睛......和别人不一样。"\n\n韩墨的动作顿了顿。\n\n"哪里不一样？"\n\n"你看我的时候......没有嫌弃。"\n\n青衣的声音很轻，轻得像一阵风，"别人看我，都像在看一个怪物。可你看我......像在看......"\n\n她顿住了，似乎在寻找合适的词。\n\n"......一个有用的人。"\n\n韩墨笑了。\n\n那笑容很淡，却让人捉摸不透。\n\n"或许吧。"\n\n他低下头，继续擦拭她的伤口，"在这个世道，没有用的人，早就死了。"', '{"content": "\\u7b2c4\\u7ae0 - \\u836f\\u5974\\u9752\\u8863\\n\\n\\"\\u6709\\u610f\\u601d\\u3002\\"\\n\\n\\u8001\\u5934\\u91cd\\u590d\\u4e86\\u4e00\\u904d\\u8fd9\\u4e09\\u4e2a\\u5b57\\uff0c\\u90a3\\u53cc\\u6d51\\u6d4a\\u7684\\u8001\\u773c\\u5728\\u97e9\\u58a8\\u8eab\\u4e0a\\u6765\\u56de\\u522e\\u4e86\\u51e0\\u904d\\uff0c\\u50cf\\u662f\\u5728\\u4f30\\u91cf\\u4e00\\u4ef6\\u8d27\\u7269\\u7684\\u6210\\u8272\\u3002\\n\\n\\"\\u65e2\\u4e0d\\u662f\\u836f\\u738b\\u8c37\\u7684\\uff0c\\u4e5f\\u4e0d\\u662f\\u54ea\\u95e8\\u54ea\\u6d3e\\u7684\\uff0c\\u5374\\u80fd\\u4e00\\u773c\\u77a7\\u51fa\\u4e4c\\u5934\\u914d\\u534a\\u590f\\u7684\\u5fcc\\u8bb3\\u3002\\"\\u8001\\u5934\\u6162\\u541e\\u541e\\u5730\\u6536\\u56de\\u8eab\\u5b50\\uff0c\\u91cd\\u65b0\\u62ff\\u8d77\\u90a3\\u6746\\u94f6\\u79e4\\uff0c\\"\\u8fd9\\u5e74\\u5934\\uff0c\\u8ba4\\u5b57\\u7684\\u7a77\\u9178\\u8bfb\\u4e66\\u4eba\\u4e0d\\u5c11\\uff0c\\u8ba4\\u5f97\\u836f\\u7684\\u53ef\\u4e0d\\u591a\\u3002\\"\\n\\n\\u97e9\\u58a8\\u5782\\u7740\\u773c\\uff0c\\u6ca1\\u6562\\u63a5\\u8bdd\\u3002\\n\\n\\u5728\\u8fd9\\u79cd\\u4eba\\u7cbe\\u9762\\u524d\\uff0c\\u591a\\u8bf4\\u662f\\u9519\\uff0c\\u5c11\\u8bf4\\u4e5f\\u662f\\u9519\\uff0c\\u552f\\u6709\\u88c5\\u50bb\\u5145\\u6123\\uff0c\\u624d\\u80fd\\u6d3b\\u5f97\\u4e45\\u4e9b\\u3002\\n\\n\\"\\u7f62\\u4e86\\u3002\\"\\n\\n\\u8001\\u5934\\u6446\\u4e86\\u6446\\u624b\\uff0c\\